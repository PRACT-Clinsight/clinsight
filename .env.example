# ==========================================
# FutureLoop Autonomous Content System Config
# ==========================================

# 1. Core LLM Configuration (Required for Auto-Generation)
# Get a key from: https://aistudio.google.com/
GEMINI_API_KEY=

# 2. X (Twitter) Direct Posting API Keys (Optional)
# Get keys from: https://developer.twitter.com/
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# 3. LinkedIn Direct Posting Keys (Optional)
# Get token from: https://developer.linkedin.com/
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_ID=

# 4. Buffer API Configuration (Alternative for multi-platform auto-posting)
# Connects to both X and LinkedIn. Get token from: https://publish.buffer.com/developers
BUFFER_ACCESS_TOKEN=
BUFFER_PROFILE_IDS=

# 5. Local System Config
CONTENT_OUTPUT_DIR=./content
PORTING_MODE=simulation # Set to "production" to enable live posting
